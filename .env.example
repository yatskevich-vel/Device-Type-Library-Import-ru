NETBOX_TOKEN=XXXXXXXXX-xxxxxxxxx
NETBOX_URL=https://netbox.example.org

REPO_BRANCH=master
REPO_URL=https://github.com/netbox-community/devicetype-library.git

# Локальный путь, куда клонируется репозиторий библиотеки типов устройств.
# По умолчанию используется директория "repo" в корне проекта, если не задана.
# Используйте абсолютный путь или путь относительно расположения запуска скрипта.
#REPO_PATH=./repo

# Параметры SSL — выберите один из вариантов, если ваш NetBox использует самоподписанный или внутренний CA:
#
#   Вариант А (рекомендуемый): укажите requests на ваш CA bundle, чтобы сертификат
#   проверялся корректно. Установите REQUESTS_CA_BUNDLE на путь к вашему PEM-encoded
#   сертификату CA или файлу bundle. Это стандартная переменная requests/urllib3, которая
#   также учитывается большинством Python HTTP-клиентов.
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/my-internal-ca.pem
#
#   Вариант Б (небезопасно – только для разработки/тестирования): полностью отключите проверку сертификатов.
#   IGNORE_SSL_ERRORS=False — безопасный параметр по умолчанию; устанавливайте True только для локальной/开发енной работы.
#   ВНИМАНИЕ: Это обходит все проверки сертификатов и подвергает соединения атакам
#   типа "человек посередине". Никогда не включайте в производственных средах.
IGNORE_SSL_ERRORS=False

# Опционально: ограничить импорт конкретными slug типами устройств
#SLUGS=c9300-48u isr4431 isr4331

# Настройка производительности — в зависимости от размера вашего экземпляра NetBox и сети
# Количество элементов на страницу GraphQL (по умолчанию: 5000).
# Значения до 25000 успешно тестировались на экземпляре NetBox по умолчанию
# с минимальной дополнительной задержкой. Большинство установок NetBox
# ограничивают MAX_PAGE_SIZE значением 1000 по умолчанию; клиент определяет
# ограничение на стороне сервера и разбивает на страницы соответственно.
#GRAPHQL_PAGE_SIZE=5000

# Количество потоков для параллельной предзагрузки компонентов (по умолчанию: 8).
# Уменьшайте на较小ых экземплярах для снижения нагрузки; увеличивайте для более быстрого импорта.
#PRELOAD_THREADS=8